# Custom 404 Error Document
ErrorDocument 404 /404.html

# Enable the Rewrite Engine
RewriteEngine On

# Redirect specific files to their new locations under /blogs/
RewriteCond %{HTTPS} on
RewriteCond %{REQUEST_URI} ^/barrierefreies-design [OR]
RewriteCond %{REQUEST_URI} ^/cyberkriminalitaet [OR]
RewriteCond %{REQUEST_URI} ^/junge-unternehmer [OR]
RewriteCond %{REQUEST_URI} ^/kunden-bindung [OR]
RewriteCond %{REQUEST_URI} ^/selbststaendigkeit [OR]
RewriteCond %{REQUEST_URI} ^/seo-grundlagen [OR]
RewriteCond %{REQUEST_URI} ^/technologien
RewriteRule ^ https://webtree.ch/blogs%{REQUEST_URI} [R=301,L]

# Handle 404 Errors - Redirect if file or directory does not exist
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /404.html [L]
